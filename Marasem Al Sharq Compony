/**
 * Template Name: صفحة الخدمات الموحدة
 * Description: نموذج موحد يعرض قائمة الخدمات ويوفر خريطة موقع مخصصة للخدمات
 */

get_header();

// تحديد نوع الطلب: عرض الصفحة العادية أو خريطة الموقع
$is_sitemap_request = isset($_GET['sitemap']) && $_GET['sitemap'] === 'services';

if ($is_sitemap_request) {
    // إعدادات خريطة الموقع (XML)
    header('Content-Type: application/xml; charset=utf-8');
    
    echo '<?xml version="1.0" encoding="UTF-8"?>';
    echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">';
    
    // جلب جميع الخدمات لخريطة الموقع
    $services_args = array(
        'post_type' => 'service',
        'posts_per_page' => -1,
        'orderby' => 'date',
        'order' => 'DESC'
    );
    
    $services_query = new WP_Query($services_args);
    
    if ($services_query->have_posts()) {
        while ($services_query->have_posts()) {
            $services_query->the_post();
            $last_modified = get_post_modified_time('Y-m-d', false, get_the_ID());
            $priority = (is_front_page()) ? '1.0' : '0.8';
            
            echo '<url>';
            echo '<loc>' . esc_url(get_permalink()) . '</loc>';
            echo '<lastmod>' . $last_modified . '</lastmod>';
            echo '<changefreq>weekly</changefreq>';
            echo '<priority>' . $priority . '</priority>';
            echo '</url>';
        }
    }
    wp_reset_postdata();
    
    echo '</urlset>';
    exit;
}

// عرض الصفحة العادية للخدمات
?>

<div class="services-container">
    <header class="page-header">
        <h1 class="page-title"><?php the_title(); ?></h1>
    </header>

    <div class="services-content">
        <?php
        if (have_posts()) :
            while (have_posts()) : the_post();
                the_content();
            endwhile;
        endif;
        ?>
    </div>

    <div class="services-list">
        <?php
        $services_args = array(
            'post_type' => 'service',
            'posts_per_page' => 12,
            'orderby' => 'menu_order',
            'order' => 'ASC'
        );
        
        $services_query = new WP_Query($services_args);
        
        if ($services_query->have_posts()) :
        ?>
            <div class="services-grid">
                <?php while ($services_query->have_posts()) : $services_query->the_post(); ?>
                    <div class="service-item">
                        <article id="post-<?php the_ID(); ?>" <?php post_class(); ?>>
                            <?php if (has_post_thumbnail()) : ?>
                                <div class="service-thumbnail">
                                    <a href="<?php the_permalink(); ?>">
                                        <?php the_post_thumbnail('medium'); ?>
                                    </a>
                                </div>
                            <?php endif; ?>
                            
                            <div class="service-content">
                                <h2 class="service-title">
                                    <a href="<?php the_permalink(); ?>"><?php the_title(); ?></a>
                                </h2>
                                
                                <div class="service-excerpt">
                                    <?php the_excerpt(); ?>
                                </div>
                                
                                <div class="service-link">
                                    <a href="<?php the_permalink(); ?>" class="button">عرض التفاصيل</a>
                                </div>
                            </div>
                        </article>
                    </div>
                <?php endwhile; ?>
            </div>
            
            <?php
            // إضافة رابط لتنزيل خريطة الموقع
            echo '<div class="sitemap-download">';
            echo '<a href="' . get_permalink() . '?sitemap=services" class="sitemap-link" download="services-sitemap.xml">';
            echo '<i class="fas fa-download"></i> تنزيل خريطة الموقع للخدمات';
            echo '</a>';
            echo '</div>';
            
            wp_reset_postdata();
        else :
            echo '<p class="no-services">لا توجد خدمات متاحة حالياً.</p>';
        endif;
        ?>
    </div>
</div>

